{
	"compilerOptions": {
		"target": "ESNext",
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"moduleDetection": "force",
		"types": ["bun"],
		"strict": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["*.ts", "src/**/*.ts", "tests/**/*.ts"],
	"exclude": ["node_modules", "dist", ".cache", ".venv"]
}
